generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                  String               @id @default(cuid())
  name                String
  phone               String               @unique
  password            String
  role                String               @default("STUDENT")
  avatar              String?
  goal                String?
  assignments         Assignment[]         @relation("TeacherAssignments")
  submissions         Submission[]
  assignedAssignments AssignmentStudent[]
  createdAt           DateTime             @default(now())
}

model Assignment {
  id               String              @id @default(cuid())
  title            String
  description      String?
  type             String
  deadline         DateTime
  teacher          User                @relation("TeacherAssignments", fields: [teacherId], references: [id])
  teacherId        String
  questions        Question[]
  submissions      Submission[]
  assignedStudents AssignmentStudent[]
  media            AssignmentMedia[]
  createdAt        DateTime            @default(now())
}

model AssignmentMedia {
  id           String     @id @default(cuid())
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  assignmentId String
  type         String
  url          String
  title        String?
  orderIndex   Int        @default(0)
}

model AssignmentStudent {
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  assignmentId String
  student      User       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId    String

  @@id([assignmentId, studentId])
}

model Question {
  id           String               @id @default(cuid())
  assignment   Assignment           @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  assignmentId String
  text         String
  orderIndex   Int
  options      AnswerOption[]
  responses    SubmissionResponse[]
}

model AnswerOption {
  id         String               @id @default(cuid())
  question   Question             @relation(fields: [questionId], references: [id], onDelete: Cascade)
  questionId String
  text       String
  isCorrect  Boolean              @default(false)
  responses  SubmissionResponse[]
}

model Submission {
  id               String               @id @default(cuid())
  assignment       Assignment           @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  assignmentId     String
  student          User                 @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId        String
  status           String               @default("SUBMITTED")
  grade            Int?
  feedback         String?
  textAnswer       String?
  voiceUrl         String?
  responses        SubmissionResponse[]
  submittedAt      DateTime             @default(now())
  gradedAt         DateTime?

  @@unique([assignmentId, studentId])
}

model SubmissionResponse {
  id               String        @id @default(cuid())
  submission       Submission    @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  submissionId     String
  question         Question      @relation(fields: [questionId], references: [id])
  questionId       String
  selectedOption   AnswerOption? @relation(fields: [selectedOptionId], references: [id])
  selectedOptionId String?
  textAnswer       String?
}
